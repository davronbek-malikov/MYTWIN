# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model for chat + vision (gpt-4o supports both text and images)
OPENAI_MODEL=gpt-4o

# Your name (shown in system prompts)
OWNER_NAME=YourName

# SQLite database file path
DATABASE_PATH=twin.db

# Max messages kept in conversation memory per user
MAX_HISTORY=40

# Google Sheets integration (optional — leave blank to disable)
# Paste the Web App URL from your Google Apps Script deployment
GOOGLE_WEBHOOK_URL=
