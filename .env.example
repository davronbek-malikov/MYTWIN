# ── Required ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OWNER_NAME=YourName
MAX_HISTORY=40

# ── Database ───────────────────────────────────────────────────────────────
# Supabase (production / Vercel):
#   Go to supabase.com → your project → Settings → Database → Connection string
#   Use the "Session pooler" URL (port 5432) for Vercel serverless
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# SQLite (local dev only — ignored when DATABASE_URL is set)
DATABASE_PATH=twin.db

# ── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_WEBHOOK_URL=
GOOGLE_SHEET_ID=

# ── Desktop voice assistant (local only) ─────────────────────────────────
WAKE_WORD=Twin
VOICE_NAME=nova
MICROPHONE_INDEX=
